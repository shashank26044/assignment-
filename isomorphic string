bool isIsomorphic(char* s, char* t) {
    int map1[256] = {0};
    int map2[256] = {0};

    for (int i = 0; s[i] != '\0'; i++) {
        unsigned char c1 = s[i];
        unsigned char c2 = t[i];

        if (map1[c1] != map2[c2]) {
            return false;
        }

        map1[c1] = i + 1;
        map2[c2] = i + 1;
    }

    return true;
}
